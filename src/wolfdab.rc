#define IDI_WOLFDAB 101
IDI_WOLFDAB ICON "../assets/wolfdab.ico"
1 24 "wolfdab.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,11,0
 PRODUCTVERSION 1,0,11,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Freewaves.it"
      VALUE "FileDescription", "WolfDAB DAB/DAB+ Multiplex Transmitter"
      VALUE "FileVersion", "1.0.11"
      VALUE "InternalName", "WolfDAB"
      VALUE "LegalCopyright", "© Freewaves.it - Emanuele Pelicioli"
      VALUE "OriginalFilename", "WolfDAB.exe"
      VALUE "ProductName", "WolfDAB"
      VALUE "ProductVersion", "1.0.11"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
